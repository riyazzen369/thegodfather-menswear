{
  "name": "thegodfather-menswear",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "deploy": "bash scripts/deploy.sh",
    "test": "bash tests/run.sh",
    "test:vault-fps": "bash tests/run.sh vaultfps.js",
    "images": "python3 scripts/imgs.py",
    "test:inspect": "bash tests/run.sh inspect-flip.js",
    "test:rls": "node tests/rls-local.mjs",
    "test:live": "cd tests && node live-catalogue.js",
    "test:admin": "cd tests && node admin-tabs.js",
    "test:attire": "cd tests && node attire-editor.js",
    "seed": "node scripts/seed-supabase.mjs",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@supabase/supabase-js": "^2.119.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "description": "The Godfather Menswear: cinematic React + Three.js storefront",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  }
}
